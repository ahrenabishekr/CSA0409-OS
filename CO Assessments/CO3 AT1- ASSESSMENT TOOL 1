1. Translation of Logical Address into Physical Address
#include <stdio.h>

int main() {
    int base, limit, logical, physical;

    printf("Enter Base Register: ");
    scanf("%d", &base);

    printf("Enter Limit Register: ");
    scanf("%d", &limit);

    printf("Enter Logical Address: ");
    scanf("%d", &logical);

    if (logical < limit) {
        physical = base + logical;
        printf("Valid Address\n");
        printf("Physical Address = %d\n", physical);
    } else {
        printf("Invalid Address! Memory Access Denied.\n");
    }

    return 0;
}
 OUTPUT
Enter Base Register: 1000
Enter Limit Register: 500
Enter Logical Address: 250
Valid Address
Physical Address = 1250

2. Paging Memory Management Scheme
#include <stdio.h>

int main() {
    int pageTable[10];
    int n, page, offset, frame, physical;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter frame number for each page:\n");
    for(int i=0;i<n;i++) {
        printf("Page %d -> ", i);
        scanf("%d",&pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d",&page);

    printf("Enter Offset: ");
    scanf("%d",&offset);

    if(page < n) {
        frame = pageTable[page];
        physical = frame * 100 + offset;
        printf("Frame Number = %d\n", frame);
        printf("Physical Address = %d\n", physical);
    } else {
        printf("Invalid Page Number\n");
    }

    return 0;
}
 OUTPUT
Enter number of pages: 3
Page 0 -> 5
Page 1 -> 2
Page 2 -> 7
Enter Page Number: 1
Enter Offset: 40
Frame Number = 2
Physical Address = 240

3. Page Table Simulation
#include <stdio.h>

int main() {
    int pageTable[10];
    int n, page, offset;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter frame number for each page:\n");
    for(int i=0;i<n;i++) {
        printf("Page %d -> ",i);
        scanf("%d",&pageTable[i]);
    }

    printf("Enter Logical Address (Page Offset): ");
    scanf("%d%d",&page,&offset);

    if(page<n) {
        printf("Page %d is mapped to Frame %d\n",page,pageTable[page]);
        printf("Physical Address = %d\n",pageTable[page]*100+offset);
    }
    else
        printf("Invalid Page Number\n");

    return 0;
}
