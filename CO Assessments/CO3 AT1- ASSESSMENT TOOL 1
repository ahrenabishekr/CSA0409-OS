4. Translation Lookaside Buffer (TLB) Simulation
#include <stdio.h>

int main() {
    float hitRatio;
    int memoryTime;
    float withoutTLB, withTLB;

    printf("Enter Memory Access Time (ns): ");
    scanf("%d",&memoryTime);

    printf("Enter TLB Hit Ratio (0-1): ");
    scanf("%f",&hitRatio);

    withoutTLB = 2 * memoryTime;
    withTLB = hitRatio * memoryTime + (1-hitRatio) * (2*memoryTime);

    printf("\nWithout TLB = %.2f ns\n",withoutTLB);
    printf("With TLB = %.2f ns\n",withTLB);

    return 0;
}
      OUTPUT
Enter Memory Access Time (ns): 100
Enter TLB Hit Ratio (0-1): 0.8p
Without TLB = 200.00 ns
With TLB = 120.00 ns


5. Memory Protection using Base and Limit Registers
#include <stdio.h>

int main() {
    int base, limit, logical;

    printf("Enter Base Register: ");
    scanf("%d",&base);

    printf("Enter Limit Register: ");
    scanf("%d",&limit);

    printf("Enter Logical Address: ");
    scanf("%d",&logical);

    if(logical>=0 && logical<limit)
        printf("Access Allowed\nPhysical Address = %d\n",base+logical);
    else
        printf("Access Denied! Invalid Address\n");

    return 0;
}
